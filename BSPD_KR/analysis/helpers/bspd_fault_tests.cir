echo "RESULT rear_short_to_5V (expect trip): sdc_closed_before=$&sdc_before sdc_closed_1s_after=$&sdc_after fault_n_min=$&fault_min"
meas tran trip_at WHEN v(sdc)=0.5 FALL=1
* current_short_to_5V: expect trip
alterparam curf=5.0
