* hard_braking_only_4V: expect no trip
alterparam curf=2.5
alterparam bff=4.0
alterparam brf=4.0
alterparam te=2.0
alterparam ton=0
reset
tran 200u 2.6 0 500u uic
meas tran sdc_before FIND v(sdc) AT=0.95
meas tran sdc_after FIND v(sdc) AT=2.0
