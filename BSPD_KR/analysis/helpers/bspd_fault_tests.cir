* sensors_valid_200ms_late: expect no trip
alterparam curf=2.5
alterparam bff=0.6
alterparam brf=0.6
alterparam te=3.0
alterparam ton=0.2
reset
tran 200u 2.6 0 500u uic
meas tran sdc_before FIND v(sdc) AT=0.95
meas tran sdc_after FIND v(sdc) AT=2.0
