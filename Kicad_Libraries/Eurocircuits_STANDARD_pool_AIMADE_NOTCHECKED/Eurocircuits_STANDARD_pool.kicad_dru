(version 1)
#
# Eurocircuits STANDARD pool (POOLING) - custom design rules for KiCad 10.0
# Profile EC-STD-POOL-2L-155-18U-RT, revision 1 (2026-10-12), checked with KiCad 10.0.6
# Board: 2 layers, FR-4, 1.55 mm nominal laminate, 18 um base copper (about 35 um final),
#        routed edges (2.00 mm break-routing tool), green/blue/black/red DI soldermask.
# Sources and the full parameter table: README.md shipped with this file.
#
# HOW THIS FILE WORKS
# * The floors live in Board Setup > Constraints (stored in the .kicad_pro):
#     track 0.10, clearance 0.10, connection 0.10, annular ring 0.15 (finished hole),
#     via 0.40, through hole 0.10, hole-to-hole 0.25, copper-to-hole 0.20,
#     copper-to-edge 0.25, legend text 1.00 mm high / 0.10 mm stroke.
#   They apply wherever no custom rule matches, and net-class values are clamped to
#   them. Every rule below only RAISES a limit (the optional castellated rule is the
#   one deliberate exception).
# * KiCad 10.0.6 behaviour (verified, contrary to the KiCad manual): a matching custom
#   rule with a LOWER minimum replaces the floor and no error is reported. Never add
#   project rules (e.g. BGA neck-downs) below the Eurocircuits values.
# * KiCad hole sizes are FINISHED sizes. Eurocircuits wants finished sizes (ENDSIZE) in
#   the drill file and drills PTH with TOOLSIZE = ENDSIZE + 0.10 mm, NPTH with
#   TOOLSIZE = ENDSIZE. Tool-based Eurocircuits limits are converted ONCE below.
# * For one constraint type, the LAST matching rule in this file wins. When merging
#   with project rules, keep these EC rules at the TOP so your more specific rules
#   (HV clearances, power-net widths, ...) come later and take precedence.
# * No rule in this file sets "clearance", so net-class clearances stay in force.
# * KiCad 10.0.6 behaviour (verified): a matching rule with (severity warning) turns
#   EVERY violation of that constraint into a warning, even below the hard floor.
#   Do not add "advisory" warning rules for track_width, clearance, hole_size,
#   annular_width, via_diameter, hole_to_hole, hole_clearance or edge_clearance.
# * KiCad 10.0.6 behaviour (verified): one syntax error disables the WHOLE file and
#   kicad-cli does not report it. Press "Check Rule Syntax" after every edit.
#

# ---------------------------------------------------------------- holes and slots
# Drill class E (pooled): smallest finished NPTH 0.20 mm (PTH 0.10 mm is the board floor).
(rule "EC NPTH min finished hole 0.20 mm"
    (condition "A.Pad_Type == 'NPTH, mechanical'")
    (constraint hole_size (min 0.20mm)))

# Smallest slot width 0.50 mm finished, plated or non-plated (oval pad holes).
(rule "EC slot min width 0.50 mm"
    (condition "A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.50mm)))

# Hole to hole: 0.25 mm edge to edge measured on TOOLSIZE.
#   NPTH-NPTH 0.25 (board floor) / PTH-NPTH 0.25+0.05 / PTH-PTH 0.25+0.05+0.05 (finished).
#   KiCad does not run this check on oval (milled) holes.
(rule "EC hole-to-hole with a plated hole 0.30 mm"
    (condition "A.isPlated() || B.isPlated()")
    (constraint hole_to_hole (min 0.30mm)))

(rule "EC hole-to-hole plated-plated 0.35 mm"
    (condition "A.isPlated() && B.isPlated()")
    (constraint hole_to_hole (min 0.35mm)))

# Copper to an unconnected hole (IPI 0.20 mm from TOOLSIZE):
#   NPTH 0.20 (board floor) / plated hole 0.20+0.05 (finished).
#   Pairs that involve an NPTH pad keep the 0.20 floor. Note "!(x == y)" is used on
#   purpose: in KiCad 10.0.6 "x != y" is false when x does not exist (e.g. a track).
(rule "EC copper to plated hole 0.25 mm"
    (condition "(A.isPlated() && !(B.Pad_Type == 'NPTH, mechanical')) || (B.isPlated() && !(A.Pad_Type == 'NPTH, mechanical'))")
    (constraint hole_clearance (min 0.25mm)))

# ------------------------------------------------------------- vias / layer pairs
# Blind, buried and micro vias are non-pooling specials in STANDARD pool.
(rule "EC no blind/buried/micro vias (not poolable)"
    (constraint disallow blind_via buried_via micro_via))

# ---------------------------------------------------------------- copper features
# Copper text strokes must meet the pattern-class track width.
(rule "EC copper text stroke 0.10 mm"
    (severity error)
    (condition "A.Layer == '*.Cu'")
    (constraint text_thickness (min 0.10mm)))

# Inner-layer copper to routed edge 0.40 mm (only objects that live on inner layers;
# no effect on 2-layer boards). For through vias/PTH pads see the multilayer block.
(rule "EC inner-layer copper to routed edge 0.40 mm"
    (condition "A.Layer == 'In*.Cu'")
    (constraint edge_clearance (min 0.40mm)))

# Eurocircuits converts hatching thinner than 0.20 mm or with gaps below 0.40 mm to
# solid copper (warning only - applies to every zone's hatch settings).
(rule "EC hatched zone line 0.20 mm / gap 0.40 mm"
    (severity warning)
    (condition "A.Type == 'Zone'")
    (constraint assertion "A.Hatch_Width >= 0.2mm && A.Hatch_Gap >= 0.4mm"))

# --------------------------------------------------------------------- soldermask
# NPTH without copper needs a mask annular ring (MAR) of 0.125 mm.
(rule "EC NPTH without copper: mask opening +0.125 mm per side"
    (condition "A.Pad_Type == 'NPTH, mechanical' && A.Size_X <= A.Hole_Size_X && A.Size_Y <= A.Hole_Size_Y")
    (constraint solder_mask_expansion (opt 0.125mm)))

# ------------------------------------------------------------ legend (silkscreen)
# Eurocircuits clips or removes non-compliant legend, so these report as warnings.
(rule "EC legend line width 0.10 mm"
    (severity warning)
    (condition "A.Type == 'Graphic' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS') && A.Fill != 'Solid'")
    (constraint assertion "A.Line_Width >= 0.1mm"))

# 0.10 mm to exposed copper and holes (measured to pad/via copper; conservative for
# tented vias).
(rule "EC legend to pads and vias 0.10 mm"
    (condition "(A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS') && (B.Type == 'Pad' || B.Type == 'Via')")
    (constraint silk_clearance (min 0.10mm)))

(rule "EC legend to routed board edge 0.25 mm"
    (condition "B.Layer == 'Edge.Cuts'")
    (constraint silk_clearance (min 0.25mm)))

# =================================================================================
# OPTIONAL BLOCKS - to enable one, delete the leading "# " from its rule lines only.
# Lines starting with "##" are explanations and must stay commented.
# =================================================================================
#
## MULTILAYER (4/6/8 layers, pooled). Inner pad = finished hole + 0.35 mm
## (IAR 0.125 mm on TOOLSIZE) and inner copper 0.40 mm from routed edges. KiCad cannot
## tell whether a pad has inner copper on a 2-layer board, so this is off by default.
# (rule "EC multilayer annular ring 0.175 mm (inner IAR)"
#     (condition "A.isPlated()")
#     (constraint annular_width (min 0.175mm)))
# (rule "EC multilayer plated holes/vias to routed edge 0.40 mm (inner pads)"
#     (condition "A.isPlated()")
#     (constraint edge_clearance (min 0.40mm)))
#
## MULTILAYER with 35 um inner copper (inner track/gap 0.125 mm): do NOT add a
## clearance rule here - a custom clearance rule replaces (and can LOWER) net-class
## clearances such as a high-voltage class. Raise Board Setup > Constraints >
## Minimum clearance and Minimum track width to 0.125 mm for the whole board instead.
#
## V-SCORED (V-cut) EDGES: 0.45 mm on all layers. Also raise Board Setup >
## Constraints > Copper to edge clearance to 0.45 mm (the board floor).
# (rule "EC V-cut legend to edge 0.45 mm"
#     (condition "B.Layer == 'Edge.Cuts'")
#     (constraint silk_clearance (min 0.45mm)))
# (rule "EC V-cut copper to edge 0.45 mm (all layers)"
#     (constraint edge_clearance (min 0.45mm)))
#
## CASTELLATED / PLATED-EDGE pads (pooled option "plated holes on edge"; mark the
## plated edge in the mechanical layer). Lets pads whose fabrication property is
## "Castellated pad" cross the board edge. Must stay below the V-cut block.
# (rule "EC castellated pads may cross the edge"
#     (condition "A.Fabrication_Property == 'Castellated pad'")
#     (constraint edge_clearance (min -1mm)))
